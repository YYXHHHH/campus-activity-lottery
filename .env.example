# 复制为 .env 后按需修改；SECRET_KEY 必须替换为随机值，否则服务拒绝启动。
# 生成 SECRET_KEY：python -c "import secrets;print(secrets.token_hex(32))"

# ---- 站点身份 ----
# 应用名（BRAND_NAME 未设置时作为站名）
APP_NAME=校园活动抽签系统
# 站点全称：登录页大标题、浏览器标题、接口文档标题
BRAND_NAME=校园活动抽签系统
# 导航栏短名称，留空则与 BRAND_NAME 相同
BRAND_SHORT_NAME=校园活动
# 主题色 #rrggbb，hover 深色自动派生
BRAND_COLOR=#2563eb
# 界面术语覆盖（JSON 单行），键名见 app/branding.py 的 LABELS
# 例：UI_LABELS={"activity.list_title":"会议室列表","activity.unit":"会议室","user.student":"申请人"}
UI_LABELS=

# ---- 服务与数据库 ----
SECRET_KEY=change-me-to-a-random-64-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./app.db
# 二维码里写入的地址；手机签到时必须填局域网可达地址，如 http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000
# 切换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/activity_lottery?charset=utf8mb4

# ---- 自动抽签 ----
AUTO_LOTTERY_ENABLED=true
AUTO_LOTTERY_INTERVAL_SECONDS=30

# ---- 初始管理员（由 seed.py 创建，上线前务必修改）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
